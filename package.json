{
  "name": "language-loop",
  "version": "0.4.2",
  "description": "A localization loop for vibe-coding agents. Scans code, extracts i18n keys, translates only what changed, and automatically holds unsafe translations back.",
  "type": "module",
  "license": "MIT",
  "author": "Christian Buchholz",
  "homepage": "https://github.com/Keilo2025/language-loop#readme",
  "bugs": {
    "url": "https://github.com/Keilo2025/language-loop/issues"
  },
  "keywords": [
    "i18n",
    "l10n",
    "internationalization",
    "localization",
    "translation",
    "next-intl",
    "react-i18next",
    "vue-i18n",
    "claude-code",
    "cursor",
    "codex",
    "agents",
    "evals",
    "ai-agent",
    "plugin",
    "vibe-coding"
  ],
  "bin": {
    "language-loop": "dist/cli.js",
    "lloop": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./locales": "./dist/core/locales.js",
    "./orchestration": "./dist/orchestration.js"
  },
  "files": [
    "dist",
    "skills",
    "commands",
    "agents",
    "evals",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test \"tests/**/*.test.js\"",
    "test:contract": "npm run build && node --test tests/marketing-handoff.test.js",
    "test:orchestration": "npm run build && node --test tests/orchestration.test.js tests/runner.test.js",
    "loop": "node dist/cli.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "version": "node scripts/sync-plugin-version.mjs && git add .claude-plugin/plugin.json"
  },
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Keilo2025/language-loop.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
